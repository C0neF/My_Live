<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The external JVM app needs real paths for its executable, JRE and media DLLs. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Version>$(DesktopVersion)</Version>
    <AssemblyName>MyLive</AssemblyName>
    <Product>MyLive</Product>
    <Title>MyLive</Title>
    <ApplicationIcon Condition="'$(LauncherIcon)' != ''">$(LauncherIcon)</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Include="$(AppImageDir)/**/*" Condition="'$(AppImageDir)' != ''">
      <Link>MyLive/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <Target Name="ValidateAppImage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DesktopVersion)' == ''" Text="Build through :desktop:packageSingleFile, or pass DesktopVersion from desktop/version.properties." />
    <Error Condition="'$(AppImageDir)' == '' Or !Exists('$(AppImageDir)/MyLive.exe')" Text="Build the Windows app image first and pass AppImageDir." />
  </Target>
  <Target Name="KeepOneSingleFileOutput" AfterTargets="Publish" Condition="'$(SingleFileOutputRoot)' != ''">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Clean-SingleFile.ps1&quot; -RootDirectory &quot;$(SingleFileOutputRoot)&quot; -KeepExecutable &quot;$(PublishDir)/MyLive.exe&quot;" />
  </Target>
  <Target Name="BundleDotnetRuntimeNotices" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <LauncherRuntimePack Include="@(ResolvedRuntimePack->WithMetadataValue('FrameworkName', 'Microsoft.NETCore.App'))" />
      <DotnetNotice Include="@(LauncherRuntimePack->'%(PackageDirectory)/LICENSE.TXT');@(LauncherRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
      <ResolvedFileToPublish Include="@(DotnetNotice)">
        <RelativePath>MyLive/app/resources/notices/dotnet/%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="!Exists('%(DotnetNotice.Identity)')" Text="The .NET runtime notice is missing: %(DotnetNotice.Identity)" />
  </Target>
</Project>
